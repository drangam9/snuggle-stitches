{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snuggle-stitches",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snuggle-stitches",
      "database_id": "441af5db-31e3-4497-b79d-7fbdb72c7e24",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "snuggle-stitches-images"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "PublicCatalog": { "type": "worker", "cache": { "enabled": true } }
  },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "PUBLIC_LIMITER", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "snuggle-stitches-staging",
      // Keep Cloudflare Access enabled for all traffic to this Worker.
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "exports": {
        "default": { "type": "worker", "cache": { "enabled": false } },
        "PublicCatalog": { "type": "worker", "cache": { "enabled": true } }
      },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1011", "simple": { "limit": 5, "period": 60 } },
        { "name": "ADMIN_LIMITER", "namespace_id": "1012", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLIC_LIMITER", "namespace_id": "1013", "simple": { "limit": 240, "period": 60 } }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "single-page-application"
      },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "secrets": {
        "required": ["ADMIN_PASSWORD"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snuggle-stitches-staging",
          "database_id": "7b2a2752-2c08-49bf-96d2-3cb613f0c0a6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "snuggle-stitches-images-staging"
        }
      ]
    },
    "production": {
      "name": "snuggle-stitches",
      "exports": {
        "default": { "type": "worker", "cache": { "enabled": false } },
        "PublicCatalog": { "type": "worker", "cache": { "enabled": true } }
      },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "ADMIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLIC_LIMITER", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "single-page-application"
      },
      "vars": {
        "ENVIRONMENT": "production"
      },
      "secrets": {
        "required": ["ADMIN_PASSWORD"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snuggle-stitches",
          "database_id": "441af5db-31e3-4497-b79d-7fbdb72c7e24",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "snuggle-stitches-images"
        }
      ]
    }
  }
}
